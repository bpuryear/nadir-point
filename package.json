{
  "name": "salvager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A single-ship space salvage game in 2D pixel art",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contactsheet": "tsx tools/contactsheet.ts"
  },
  "dependencies": {
    "pixi.js": "^8.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.5",
    "vitest": "^3.0.0"
  }
}
